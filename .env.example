# ---------------------------------------------------------------------------
# NavozCoin — variáveis de ambiente de exemplo
# Copie para .env.local (desenvolvimento) ou cadastre no painel da Vercel.
# NUNCA comite credenciais reais.
# ---------------------------------------------------------------------------

# String de conexão do MongoDB Atlas. Use o banco "navozcoin" antes do "?".
MONGODB_URI="mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/navozcoin?retryWrites=true&w=majority"

# Nome do banco usado pela aplicação. Pode ser diferente do path da URI.
MONGODB_DB="navozcoin"

# Credenciais do primeiro administrador (usadas APENAS pelo script de seed).
# Troque a senha pelo painel após o primeiro acesso.
ADMIN_USERNAME="Navoz"
ADMIN_PASSWORD="Navoz"
ADMIN_DISPLAY_NAME="Navoz"

# Origem(ns) permitida(s) para requisições de escrita. Em produção, use a URL
# pública exata do deploy. Várias origens podem ser separadas por vírgula.
# Em desenvolvimento local: http://localhost:3000
APP_ORIGIN="http://localhost:3000"

# Fuso usado para datas operacionais, gráficos e relatórios.
APP_TIMEZONE="America/Sao_Paulo"
